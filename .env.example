# ─────────────────────────────────────────────────────────────────────────────
# Kesher — variables d'environnement
# Copier ce fichier vers `.env.local` (jamais committé). Les variables
# préfixées NEXT_PUBLIC_ sont exposées au navigateur : n'y mettre aucun secret.
# ─────────────────────────────────────────────────────────────────────────────

# Nom affiché de l'application (nom de code provisoire, renommable ici).
NEXT_PUBLIC_APP_NAME=Kesher

# URL publique du site (liens absolus dans les e-mails, ICS, PWA).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — stack locale (`pnpm db:start` puis `pnpm db:status` pour les clés).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : serveur uniquement (Server Actions / jobs). JAMAIS côté client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Notifications (session 10) — l'application fonctionne sans : les envois sont alors ignorés ──
# Secret des jobs `/api/jobs/*` (Vercel Cron l'envoie automatiquement ; pg_cron : voir supabase/jobs).
CRON_SECRET=
# E-mails transactionnels (Resend ; choisir la région UE dans les réglages du workspace).
RESEND_API_KEY=
EMAIL_FROM="Kesher <no-reply@example.org>"
# Web Push (VAPID) : `pnpm exec web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# ── Sessions ultérieures (laisser vide pour l'instant) ───────────────────────
# Session 14 — observabilité
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# S'entraîner — feuilles d'exercices préparées par l'IA (ADR-0087, docs/GCP.md).
# Google Cloud, multi-région UE : `eu`, jamais `global`. Clé JSON du compte de service,
# telle quelle ou encodée en base64. `PRACTICE_AI_PROVIDER=fake` sert une feuille fixe en
# développement ; `off` coupe la fonction. Sans clé ni `fake`, le bouton n'apparaît pas.
# PRACTICE_AI_PROVIDER=fake
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=eu
# GOOGLE_SERVICE_ACCOUNT_KEY=
# PRACTICE_TEXT_MODEL=gemini-3.8-flash
# PRACTICE_IMAGE_MODEL=gemini-3.1-flash-image
# PRACTICE_TTS_MODEL=gemini-3.8-flash-tts
# PRACTICE_TTS_VOICE=Sulafat
