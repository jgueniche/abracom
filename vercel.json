{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "github": {
    "silent": false
  },
  "crons": [
    {
      "path": "/api/jobs/notifications?task=digest",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/jobs/notifications?task=reminders",
      "schedule": "30 5 * * *"
    }
  ]
}
